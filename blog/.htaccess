RewriteEngine On
RewriteBase /blog/

# Redirect index or index/ to /blog/
RewriteRule ^index/?$ /blog/ [R=301,L]

# Remove .php and redirect to clean URL with trailing slash
RewriteCond %{REQUEST_URI} ^/blog/.+\.php$
RewriteRule ^(.+)\.php$ /blog/$1/ [R=301,L]

# Add trailing slash to blog URLs without extension
RewriteCond %{REQUEST_URI} ^/blog/[^/]+$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ /blog/$1/ [R=301,L]

# Internal rewrite: clean URL to .php file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/$ $1.php [L]